<gitml theme="light" accent="violet" font="sora" title="Minha Landing Page" description="Feita com GITML">

<banner href="#cta">🚀 Novo: GITML v0.0.1 já está disponível — saiba mais</banner>

<nav brand="GITML" sticky>
  <link href="#recursos">Recursos</link>
  <link href="#precos">Preços</link>
  <link href="#faq">FAQ</link>
  <theme-toggle>
  <button href="#cta" variant="primary" size="sm">Começar</button>
</nav>

<hero variant="center"
      eyebrow="Nova linguagem declarativa"
      title="Crie páginas *modernas* sem escrever HTML"
      subtitle="O GITML transforma tags simples em páginas prontas e estilizadas — com cara de site feito em React/Next."
      cta="Começar agora" href="#cta"
      cta2="Ver exemplos" href2="#recursos">
</hero>

<marquee>
  Google · Microsoft · MIT · Stanford · NASA · Vercel
</marquee>

<section id="recursos" title="Tudo que você precisa" subtitle="Mais de 70 tags prontas para montar qualquer página." eyebrow="Recursos">
  <grid cols="3">
    <feature icon="zap" title="Rápido">Um único arquivo de motor compila tudo em milissegundos.</feature>
    <feature icon="sparkles" title="Moderno">Glassmorphism, bento grid, animações e modo escuro inclusos.</feature>
    <feature icon="shield" title="Seguro">URLs e textos são escapados automaticamente contra XSS.</feature>
    <feature icon="layers" title="Componentes">Crie seus próprios componentes com define e reutilize.</feature>
    <feature icon="globe" title="Em qualquer lugar">Roda no navegador, no Node e na extensão do VS Code.</feature>
    <feature icon="rocket" title="Zero config">Sem build, sem dependências. Só escreva e abra.</feature>
  </grid>
</section>

<section title="Números" bg="soft">
  <grid cols="4">
    <stat num="70" suffix="+" label="Componentes" />
    <stat num="1" label="Arquivo de motor" />
    <stat num="0" label="Dependências" />
    <stat num="100" suffix="%" label="Gratuito" />
  </grid>
</section>

<section id="precos" title="Preços simples" eyebrow="Planos">
  <grid cols="3">
    <pricing tier="Grátis" price="R$ 0" period="/mês" cta="Começar" href="#">
      <ul icon="check">
        <li>Páginas ilimitadas</li>
        <li>Todos os componentes</li>
      </ul>
    </pricing>
    <pricing tier="Pro" price="R$ 29" period="/mês" featured cta="Assinar" href="#">
      <ul icon="check">
        <li>Tudo do Grátis</li>
        <li>Componentes customizados</li>
        <li>Suporte prioritário</li>
      </ul>
    </pricing>
    <pricing tier="Empresa" price="Sob consulta" cta="Falar com vendas" href="#">
      <ul icon="check">
        <li>SSO e auditoria</li>
        <li>SLA dedicado</li>
      </ul>
    </pricing>
  </grid>
</section>

<section title="O que dizem" bg="soft">
  <grid cols="2">
    <testimonial name="Ana Silva" role="Dev Frontend" rating="5">
      "Escrevi uma landing page inteira em 20 minutos. Inacreditável."
    </testimonial>
    <testimonial name="Carlos Mendes" role="Professor" rating="5">
      "Meus alunos aprendem a estrutura de páginas web sem se perder no CSS."
    </testimonial>
  </grid>
</section>

<section id="faq" title="Perguntas frequentes" eyebrow="FAQ">
  <accordion title="Preciso saber HTML?">Não! As tags do GITML são mais simples e já vêm estilizadas.</accordion>
  <accordion title="Funciona offline?">Sim, o motor é um único arquivo JavaScript sem dependências.</accordion>
  <accordion title="Posso usar meu próprio CSS?">Sim, use a tag style para adicionar estilos personalizados.</accordion>
</section>

<cta id="cta" title="Pronto para criar sua primeira página?" button="Baixar o GITML" href="#">
  Escreva tags simples. Receba uma página moderna. É assim de fácil.
</cta>

<footer brand="GITML">
  <link href="#">Termos</link>
  <link href="#">Privacidade</link>
  <text muted>Feito com GITML v0.0.1</text>
</footer>

</gitml>
