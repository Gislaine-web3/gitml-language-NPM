  "Página GITML (dark)": {
    "prefix": [
      "gitml",
      "page"
    ],
    "description": "Esqueleto de uma página",
    "body": [
      "<gitml theme=\"${1|dark,light,auto|}\" accent=\"${2|violet,blue,green,orange,pink,red,teal,black|}\" font=\"space-grotesk\" title=\"${3:Meu site}\" description=\"${4}\">",
      "",
      "  <nav brand=\"${3:Meu site}\" sticky>",
      "    <link href=\"#sobre\">Sobre</link>",
      "    <theme-toggle />",
      "  </nav>",
      "",
      "  <hero eyebrow=\"${5:Novo}\" title=\"${6:Título com **destaque**}\" subtitle=\"${7:Subtítulo}\" cta=\"Começar\" href=\"#sobre\"></hero>",
      "",
      "  $0",
      "",
      "</gitml>"
    ]
  },
  "App com rotas": {
    "prefix": [
      "app",
      "rotas"
    ],
    "description": "App de várias páginas (rotas + menu + rodapé)",
    "body": [
      "<gitml theme=\"dark\" accent=\"violet\" title=\"${1:Meu app}\">",
      "",
      "  <nav brand=\"${1:Meu app}\" sticky>",
      "    <link href=\"/\">Início</link>",
      "    <link href=\"/sobre\">Sobre</link>",
      "    <theme-toggle />",
      "  </nav>",
      "",
      "  <route path=\"/\" title=\"Início\">",
      "    <hero title=\"${2:Olá}\" subtitle=\"${3}\"></hero>",
      "  </route>",
      "",
      "  <route path=\"/sobre\" title=\"Sobre\">",
      "    <section title=\"Sobre\">$0</section>",
      "  </route>",
      "",
      "  <notfound><section title=\"404\"><p>Página não encontrada.</p></section></notfound>",
      "",
      "</gitml>"
    ]
  },
  "Componente próprio (define)": {
    "prefix": [
      "define",
      "meu-componente"
    ],
    "description": "Cria um componente reutilizável",
    "body": [
      "<define name=\"${1:meu-componente}\">",
      "  <card title=\"{{${2:titulo}}}\">{{children}}</card>",
      "</define>"
    ]
  },
  "Contador com estado": {
    "prefix": [
      "contador",
      "state"
    ],
    "description": "Estado reativo sem JavaScript",
    "body": [
      "<state name=\"${1:n}\" value=\"0\" />",
      "<p>Valor: {\\$${1:n}}</p>",
      "<button action=\"inc:${1:n}\">+1</button>",
      "<button action=\"dec:${1:n}\" variant=\"outline\">−1</button>"
    ]
  },
  "Documento HTML completo (.gitml)": {
    "prefix": [
      "html",
      "documento",
      "html-gitml"
    ],
    "description": "Documento com <html>, <head> e <body> dentro de um .gitml",
    "body": [
      "<html lang=\"pt-BR\" theme=\"${1|dark,light,auto|}\" accent=\"${2|violet,blue,green,orange,pink,red,teal,black|}\" font=\"space-grotesk\">",
      "  <head>",
      "    <title>${3:Meu site}</title>",
      "    <meta name=\"description\" content=\"${4:Descrição da página}\">",
      "    <link rel=\"icon\" href=\"${5:favicon.png}\">",
      "    <style>",
      "      ${6:/* seu CSS */}",
      "    </style>",
      "  </head>",
      "  <body>",
      "    <nav brand=\"${3:Meu site}\" sticky>",
      "      <link href=\"#sobre\">Sobre</link>",
      "      <theme-toggle />",
      "    </nav>",
      "    <main>",
      "      $0",
      "    </main>",
      "  </body>",
      "</html>"
    ]
  },
  "Incluir arquivo": {
    "prefix": [
      "include"
    ],
    "description": "Importa outro arquivo .gitml",
    "body": [
      "<include src=\"${1:components/menu.gitml}\" />"
    ]
  },
  "Rota em arquivo": {
    "prefix": [
      "route-src"
    ],
    "description": "Página em arquivo separado (estilo pages/)",
    "body": [
      "<route path=\"/${1:sobre}\" title=\"${2:Sobre}\" src=\"pages/${1:sobre}.gitml\" />"
    ]
  },
  "Repetir (each)": {
    "prefix": [
      "each"
    ],
    "description": "Repete o conteúdo para cada item",
    "body": [
      "<each items=\"${1:A,B,C}\" as=\"${2:x}\">",
      "  $0",
      "</each>"
    ]
  }
